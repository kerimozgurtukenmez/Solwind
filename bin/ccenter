#!/bin/sh
# Ccenter launcher and terminal commands.
# The app folder is looked up in order: CCENTER_DIR, <this script's folder>/.. (a source checkout, or install.sh's
# ~/.local/share/ccenter/bin/ccenter), <prefix>/share/ccenter (/usr/bin -> /usr/share/ccenter), /usr/share/ccenter.

set -u

# Message language: CCENTER_LANG, else the language chosen in the app (settings.json), else the system locale
lang=${CCENTER_LANG:-}
if [ -z "$lang" ]; then
    grep -q '"lang": *"tr"' "${XDG_CONFIG_HOME:-$HOME/.config}/ccenter/settings.json" 2>/dev/null && lang=tr
    grep -q '"lang": *"en"' "${XDG_CONFIG_HOME:-$HOME/.config}/ccenter/settings.json" 2>/dev/null && lang=en
fi
[ -n "$lang" ] || case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in tr*) lang=tr ;; *) lang=en ;; esac
# t "English" "Türkçe": print the message in the chosen language
t() { if [ "$lang" = tr ]; then printf '%s\n' "$2"; else printf '%s\n' "$1"; fi; }
# err "English" "Türkçe": same, to stderr
err() { t "$@" >&2; }

self=$(readlink -f "$0")
if [ -n "${CCENTER_DIR:-}" ]; then
    dir=$CCENTER_DIR
elif [ -f "${self%/bin/ccenter}/shell.qml" ]; then
    dir=${self%/bin/ccenter}                      # source checkout or install.sh install (<app>/bin/ccenter)
elif [ -f "${self%/bin/ccenter}/share/ccenter/shell.qml" ]; then
    dir=${self%/bin/ccenter}/share/ccenter        # installed with a prefix layout (/usr or ~/.local)
else
    dir=/usr/share/ccenter
fi

if [ ! -f "$dir/shell.qml" ]; then
    err "ccenter: app files not found ($dir)" "ccenter: uygulama dosyaları bulunamadı ($dir)"
    exit 1
fi
command -v qs >/dev/null 2>&1 || { err "ccenter: quickshell (qs) is not installed" "ccenter: quickshell (qs) kurulu değil"; exit 1; }

usage() {
    if [ "$lang" = tr ]; then cat <<EOF
Kullanım: ccenter [komut]

  (komutsuz)         Pencereyi aç; uygulama çalışmıyorsa başlat
  --background       Pencere açmadan başlat (systemd servisi bunu kullanır)
  open | hide | toggle
  status             Fanlar, sıcaklıklar, aktif profil
  profiles           Profilleri listele (* = aktif)
  profile <ad>       Profil uygula (büyük/küçük harf fark etmez)
  boost <dk>         Maksimum fan: dakika, 0 = kapat, -1 = süresiz
  kbd                Klavye ışığı durumu
  kbd info           Klavye algılama raporu (laptop, sürücü, ışık, izin, destek)
  kbd color <#hex>   Klavye rengi (ör. kbd color "#ff0000")
  kbd brightness <%> Klavye parlaklığı 0-100
  kbd effect <ad>    Klavye efekti: static (sabit) | breathing (nefes) | cycle (renk geçişi)
  kbd source <ad>    Efekt renkleri: single (seçilen) | multi (liste) | theme (Caelestia)
  kbd speed <%>      Efekt hızı 0-100
  kbd range <% %>    Nefesin en düşük ve en yüksek seviyesi (ör. kbd range 10 90)
  kbd themecount <n> Caelestia kaynağında renk sayısı (3-6)
  lang <tr|en>       Arayüz dili
  report             Hata bildirmek için tanı raporu oluştur (ev klasörüne bir metin dosyası)
  quit               Tamamen kapat (Ccenter'ın kontrol ettiği fanlar NBFC'ye döner)
  --help | --version
EOF
    else cat <<EOF
Usage: ccenter [command]

  (no command)       Open the window; start the app if it isn't running
  --background       Start without a window (used by the systemd service)
  open | hide | toggle
  status             Fans, temperatures, active profile
  profiles           List profiles (* = active)
  profile <name>     Apply a profile (case-insensitive)
  boost <min>        Max fan: minutes, 0 = off, -1 = until turned off
  kbd                Keyboard light status
  kbd info           Keyboard detection report (laptop, driver, light, permission, support)
  kbd color <#hex>   Keyboard color (e.g. kbd color "#ff0000")
  kbd brightness <%> Keyboard brightness 0-100
  kbd effect <name>  Keyboard effect: static | breathing | cycle (color cycle)
  kbd source <name>  Effect colors: single (chosen) | multi (list) | theme (Caelestia)
  kbd speed <%>      Effect speed 0-100
  kbd range <% %>    Lowest and highest breathing level (e.g. kbd range 10 90)
  kbd themecount <n> Number of colors with the Caelestia source (3-6)
  lang <tr|en>       UI language
  report             Create a diagnostic report for bug reports (a text file in your home folder)
  quit               Quit completely (fans driven by Ccenter go back to NBFC)
  --help | --version
EOF
    fi
}

# Is this copy running?
running() { qs ipc -p "$dir" show >/dev/null 2>&1; }

# Is another Ccenter copy (development or installed) running? Two copies must never drive the fans at once.
other_instance() {
    qs list --all 2>/dev/null | awk -v me="$dir/shell.qml" '
        /Config path:/ { p = $3; low = tolower(p)
                         if (p != me && low ~ /ccenter\/shell\.qml$/) { print p; exit } }'
}

ipc() { qs ipc -p "$dir" call cc "$@"; }

need_running() {
    running || { err "ccenter: the app is not running (to start it: ccenter)" "ccenter: uygulama çalışmıyor (başlatmak için: ccenter)"; exit 1; }
}

# Before starting: if another copy is running, warn and exit
guard() {
    other=$(other_instance)
    if [ -n "$other" ]; then
        err "ccenter: another Ccenter copy is running: $other" "ccenter: başka bir Ccenter kopyası çalışıyor: $other"
        err "Not started, so that two copies never drive the fans at once. Quit that one first." \
            "İki kopya aynı anda fanları kontrol etmesin diye başlatılmadı. Önce onu kapat."
        exit 3                                    # the systemd service does not retry on this code (RestartPreventExitStatus=3)
    fi
}

# If the user's systemd service is enabled and runs this very copy, start the app through it: then a crash
# still hands the fans back to NBFC (ExecStopPost=nbfc set -a), which a directly started app can't do.
# Returns 0 when the window is open, 1 when the service can't be used (the caller starts the app directly),
# 2 when the service is running but the app didn't answer in time.
service_start() {
    [ -z "${CCENTER_DIR:-}" ] || return 1          # the service wouldn't get CCENTER_DIR and would run its own copy
    command -v systemctl >/dev/null 2>&1 || return 1
    [ "$(systemctl --user is-enabled ccenter.service 2>/dev/null)" = enabled ] || return 1
    # ExecStart looks like "{ path=/…/bin/ccenter ; argv[]=… }": take the path and compare it canonicalized
    exe=$(systemctl --user show -p ExecStart --value ccenter.service 2>/dev/null)
    case "$exe" in *"path="*" ;"*) ;; *) return 1 ;; esac
    exe=${exe#*path=}
    exe=${exe%% ;*}
    [ "$(readlink -f "$exe" 2>/dev/null)" = "$self" ] || return 1   # the service runs another copy (e.g. a source checkout)
    if ! systemctl --user start ccenter.service 2>/dev/null; then
        err "ccenter: the background service didn't start, starting directly (no crash protection for the fans)" \
            "ccenter: arka plan servisi başlamadı, doğrudan başlatılıyor (fanlar için çökme koruması yok)"
        return 1
    fi
    # Type=simple: start returns before the app is ready, so wait until it answers (at most ~10 s)
    n=0
    while [ "$n" -lt 50 ]; do
        ipc open >/dev/null 2>&1 && return 0
        case "$(systemctl --user show -p SubState --value ccenter.service 2>/dev/null)" in
            start-pre|start|start-post|running) ;;
            *)
                # Crashed (auto-restart shows as "activating" too), failed or stopped: stop it so it doesn't keep
                # restarting in the background, then start directly
                systemctl --user stop ccenter.service >/dev/null 2>&1
                err "ccenter: the background service stopped (see: journalctl --user -u ccenter), starting directly" \
                    "ccenter: arka plan servisi durdu (bkz: journalctl --user -u ccenter), doğrudan başlatılıyor"
                return 1 ;;
        esac
        sleep 0.2
        n=$((n + 1))
    done
    err "ccenter: started in the background but not answering yet, run ccenter again in a moment" \
        "ccenter: arka planda başladı ama henüz yanıt vermiyor, biraz sonra yine ccenter çalıştır"
    return 2
}

case "${1:-}" in
    "")
        if running; then
            ipc open
        else
            guard
            service_start
            case $? in
                0) ;;
                1) qs -p "$dir" -n -d >/dev/null 2>&1 ;;
                *) exit 1 ;;
            esac
        fi ;;
    --background)
        guard; exec env CCENTER_BACKGROUND=1 qs -p "$dir" -n ;;
    open|hide|toggle|status|profiles|quit)
        need_running; ipc "$1" ;;
    profile)
        [ $# -ge 2 ] || { err "Usage: ccenter profile <name>" "Kullanım: ccenter profile <ad>"; exit 2; }
        need_running; shift; ipc profile "$*" ;;
    boost)
        [ $# -ge 2 ] || { err "Usage: ccenter boost <minutes>" "Kullanım: ccenter boost <dakika>"; exit 2; }
        need_running; ipc boost -- "$2" ;;
    kbd)
        need_running
        case "${2:-}" in
            "") ipc kbd ;;
            info) ipc kbdInfo ;;
            color) [ $# -ge 3 ] || { err "Usage: ccenter kbd color <#rrggbb>" "Kullanım: ccenter kbd color <#rrggbb>"; exit 2; }; ipc kbdColor "$3" ;;
            brightness) [ $# -ge 3 ] || { err "Usage: ccenter kbd brightness <0-100>" "Kullanım: ccenter kbd brightness <0-100>"; exit 2; }; ipc kbdBrightness -- "$3" ;;
            effect) [ $# -ge 3 ] || { err "Usage: ccenter kbd effect <static|breathing|cycle>" "Kullanım: ccenter kbd effect <static|breathing|cycle>"; exit 2; }; ipc kbdEffect "$3" ;;
            themecount) [ $# -ge 3 ] || { err "Usage: ccenter kbd themecount <3-6>" "Kullanım: ccenter kbd themecount <3-6>"; exit 2; }; ipc kbdThemeCount -- "$3" ;;
            source) [ $# -ge 3 ] || { err "Usage: ccenter kbd source <single|multi|theme>" "Kullanım: ccenter kbd source <single|multi|theme>"; exit 2; }; ipc kbdSource "$3" ;;
            range) [ $# -ge 4 ] || { err "Usage: ccenter kbd range <lowest %> <highest %>" "Kullanım: ccenter kbd range <en düşük %> <en yüksek %>"; exit 2; }; ipc kbdRange -- "$3" "$4" ;;
            speed) [ $# -ge 3 ] || { err "Usage: ccenter kbd speed <0-100>" "Kullanım: ccenter kbd speed <0-100>"; exit 2; }; ipc kbdSpeed -- "$3" ;;
            *) err "Usage: ccenter kbd [color <#hex> | brightness <0-100> | effect <name> | source <name> | speed <0-100> | range <% %> | themecount <3-6>]" "Kullanım: ccenter kbd [color <#hex> | brightness <0-100> | effect <ad> | source <ad> | speed <0-100> | range <% %> | themecount <3-6>]"; exit 2 ;;
        esac ;;
    report)
        # Diagnostic report (works without the app running): one text file in your home folder
        exec sh "$dir/scripts/report.sh" "$dir" ;;
    lang)
        [ $# -ge 2 ] || { err "Usage: ccenter lang <tr|en>" "Kullanım: ccenter lang <tr|en>"; exit 2; }
        need_running; ipc lang "$2" ;;
    -h|--help|help)
        usage ;;
    -V|--version)
        v=$(cat "$dir/VERSION" 2>/dev/null || echo "?"); echo "ccenter $v ($dir)" ;;
    *)
        err "ccenter: unknown command: $1" "ccenter: bilinmeyen komut: $1"; usage >&2; exit 2 ;;
esac
