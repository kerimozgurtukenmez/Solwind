#!/bin/sh
# Solwind launcher and terminal commands.
# solwindd, the background service, drives the fans and the keyboard light (installed: the systemd user service
# solwind.service); the window (Quickshell) only shows and changes what it does. The terminal commands talk to
# solwindd over D-Bus (solwindd --call), with or without the window.
# Folders, in order: SOLWIND_DIR (and SOLWIND_LIB for solwindd and the QML module, default $SOLWIND_DIR/build);
# <this script's folder>/.. (a source checkout, built with `make` into <checkout>/build); <prefix>/share/solwind and
# <prefix>/lib/solwind (make install: /usr/local/bin -> /usr/local/share/solwind, /usr/local/lib/solwind);
# /usr/share/solwind and /usr/lib/solwind.
# Exit codes: 0 done, 1 error, 2 wrong usage, 3 not started (it already runs, or an old Solwind app drives the fans),
# 4 not running.

set -u

cfg=${XDG_CONFIG_HOME:-$HOME/.config}
# Solwind was called Ccenter before 0.4.0: until the first start copies its settings over, the old file is read
settings=$cfg/solwind/settings.json
[ -e "$settings" ] || settings=$cfg/ccenter/settings.json

# Message language: SOLWIND_LANG, else the language chosen in the app (settings.json), else the system locale
lang=${SOLWIND_LANG:-}
if [ -z "$lang" ]; then
    grep -q '"lang": *"tr"' "$settings" 2>/dev/null && lang=tr
    grep -q '"lang": *"en"' "$settings" 2>/dev/null && lang=en
fi
[ -n "$lang" ] || case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in tr*) lang=tr ;; *) lang=en ;; esac
# t "English" "Türkçe": print the message in the chosen language
t() { if [ "$lang" = tr ]; then printf '%s\n' "$2"; else printf '%s\n' "$1"; fi; }
# err "English" "Türkçe": same, to stderr
err() { t "$@" >&2; }

self=$(readlink -f "$0")
base=${self%/bin/*}                               # the folder that holds bin/ (works whatever the command is called)
if [ -n "${SOLWIND_DIR:-}" ]; then
    dir=$SOLWIND_DIR; lib=${SOLWIND_LIB:-$SOLWIND_DIR/build}
elif [ -f "$base/shell.qml" ]; then
    dir=$base; lib=${SOLWIND_LIB:-$base/build}    # source checkout (<checkout>/bin/solwind), built by `make`
elif [ -f "$base/share/solwind/shell.qml" ]; then
    dir=$base/share/solwind; lib=$base/lib/solwind   # make install (<prefix>/bin/solwind)
else
    dir=/usr/share/solwind; lib=/usr/lib/solwind
fi
daemon=$lib/solwindd

if [ ! -f "$dir/shell.qml" ]; then
    err "solwind: app files not found ($dir)" "solwind: uygulama dosyaları bulunamadı ($dir)"
    exit 1
fi
# (the help, the version and the report work without the build)
case "${1:-}" in -h|--help|help|-V|--version|report) ;; *)
    if [ ! -x "$daemon" ]; then
        if [ "$dir" = "$base" ]; then
            err "solwind: not built yet: run make in $base" "solwind: henüz derlenmedi: $base içinde make çalıştır"
        else
            err "solwind: solwindd not found ($daemon)" "solwind: solwindd bulunamadı ($daemon)"
        fi
        exit 1
    fi ;;
esac

usage() {
    if [ "$lang" = tr ]; then cat <<EOF
Kullanım: solwind [komut]

  (komutsuz) | open  Pencereyi aç; Solwind çalışmıyorsa önce arka plan servisini (solwindd) başlatır
  hide | toggle      Pencereyi gizle / aç-kapat
  log [-f]           Arka plan servisinin günlüğü; -f canlı izler
  status             Fanlar, sıcaklıklar, aktif profil
  profiles           Profilleri listele (* = aktif)
  profile [ad]       Profil uygula (büyük/küçük harf fark etmez); adsız: aktif profili göster
  boost [dk|on|off]  Maksimum fan: dakika, on = süresiz, off (ya da 0) = kapat; boşsa: durumu göster
  kbd                Klavye ışığı durumu
  kbd info           Klavye algılama raporu (laptop, sürücü, ışık, izin, destek)
  kbd color <#hex>   Klavye rengi (ör. kbd color "#ff0000")
  kbd brightness <%> Klavye parlaklığı 0-100
  kbd effect <ad>    Klavye efekti: static (sabit) | breathing (nefes) | cycle (renk geçişi)
  kbd source <ad>    Efekt renkleri: single (seçilen) | multi (liste) | theme (Caelestia)
  kbd speed <%>      Efekt hızı 0-100
  kbd range <% %>    Nefesin en düşük ve en yüksek seviyesi (ör. kbd range 10 90)
  kbd themecount <n> Caelestia kaynağında renk sayısı (3-6)
  lang [tr|en]       Arayüz dili; boşsa: şu anki dili göster
  report             Hata bildirmek için tanı raporu oluştur (ev klasörüne bir metin dosyası)
  quit               Tamamen kapat: pencere ve arka plan servisi (Solwind'in kontrol ettiği fanlar NBFC'ye döner,
                     klavye ışığı seçilen renginde kalır); çalışmıyorsa bir şey yapmaz
  help [komut]       Bu yardım ya da tek bir komutun yardımı (solwind <komut> --help da olur)
  --version

Komutlar pencere olmadan da çalışır (arka plan servisiyle konuşurlar).
Çıkış kodları: 0 tamam, 1 hata, 2 yanlış kullanım, 3 başlatılmadı (zaten çalışıyor ya da fanları eski bir Solwind
uygulaması sürüyor), 4 Solwind çalışmıyor.
Hatalar stderr'e yazılır.
EOF
    else cat <<EOF
Usage: solwind [command]

  (no command) | open Open the window; if Solwind isn't running, its background service (solwindd) is started first
  hide | toggle      Hide / show-or-hide the window
  log [-f]           The background service's log; -f follows it
  status             Fans, temperatures, active profile
  profiles           List profiles (* = active)
  profile [name]     Apply a profile (case-insensitive); without a name: show the active profile
  boost [min|on|off] Max fan: minutes, on = until turned off, off (or 0) = turn off; without one: show its state
  kbd                Keyboard light status
  kbd info           Keyboard detection report (laptop, driver, light, permission, support)
  kbd color <#hex>   Keyboard color (e.g. kbd color "#ff0000")
  kbd brightness <%> Keyboard brightness 0-100
  kbd effect <name>  Keyboard effect: static | breathing | cycle (color cycle)
  kbd source <name>  Effect colors: single (chosen) | multi (list) | theme (Caelestia)
  kbd speed <%>      Effect speed 0-100
  kbd range <% %>    Lowest and highest breathing level (e.g. kbd range 10 90)
  kbd themecount <n> Number of colors with the Caelestia source (3-6)
  lang [tr|en]       UI language; without one: show the current language
  report             Create a diagnostic report for bug reports (a text file in your home folder)
  quit               Quit completely: the window and the background service (fans driven by Solwind go back to
                     NBFC, the keyboard light stays on its chosen color); does nothing if it isn't running
  help [command]     This help, or the help of one command (solwind <command> --help works too)
  --version

The commands work without the window (they talk to the background service).
Exit codes: 0 done, 1 error, 2 wrong usage, 3 not started (it already runs, or an old Solwind app drives the
fans), 4 Solwind isn't running.
Errors go to stderr.
EOF
    fi
}
# Help of one command: its lines of the full help (open/hide/toggle share their lines)
usage_for() {
    usage | awk -v c="$1" 'NR == 1 { head = $0; next }
        $1 == c || (c == "open" && /^  \(.*\| open /) || (c ~ /^(hide|toggle)$/ && $1 == "hide") { lines = lines $0 "\n"; more = 1; next }
        more && /^                     / { lines = lines $0 "\n"; next }
        { more = 0 }
        END { if (lines == "") exit 1; printf "%s\n\n%s", head, lines }' \
    || { err "solwind: unknown command: $1" "solwind: bilinmeyen komut: $1"; usage >&2; exit 2; }
}
usage_error() { err "$@"; exit 2; }
is_int() { case "$1" in ""|-|*[!0-9-]*|?*-*) return 1 ;; esac; }

# ---------- the background service (solwindd) ----------
# (only "nobody holds the name" (4) is down: a busy or refusing solwindd still runs, and starting another would fail)
up() { "$daemon" --get daemon Version >/dev/null 2>&1; [ $? != 4 ]; }
need_up() {
    up || { err "solwind: Solwind isn't running (to start it: solwind)" "solwind: Solwind çalışmıyor (başlatmak için: solwind)"; exit 4; }
}
# A method of solwindd (solwindd --call): its answer to stdout, its refusal to stderr; the exit code says which
# (0 done, 1 refused, 2 wrong argument, 4 not running)
dcall() {
    "$daemon" --call "$@"
    rc=$?
    [ $rc != 4 ] || err "solwind: Solwind isn't running (to start it: solwind)" "solwind: Solwind çalışmıyor (başlatmak için: solwind)"
    return $rc
}
# The installed service runs this copy's solwindd
unit_ours() {
    [ -z "${SOLWIND_NO_SYSTEMD:-}" ] && command -v systemctl >/dev/null 2>&1 || return 1
    case "$(systemctl --user show -p ExecStart --value solwind.service 2>/dev/null)" in
        *"path=$daemon ;"*) return 0 ;;
    esac
    return 1
}
# Coming from Ccenter (the old name, before 0.4.0): before the first start its settings are copied over once. A copy,
# not a move: the old file stays where it was. solwindd reads only the new file.
copy_old_settings() {
    if [ -e "$cfg/solwind/settings.json" ] || [ ! -f "$cfg/ccenter/settings.json" ]; then return 0; fi
    if mkdir -p "$cfg/solwind" && cp "$cfg/ccenter/settings.json" "$cfg/solwind/settings.json.part" \
       && mv "$cfg/solwind/settings.json.part" "$cfg/solwind/settings.json"; then
        err "solwind: settings copied from Ccenter (Solwind's old name): $cfg/ccenter -> $cfg/solwind" \
            "solwind: ayarlar Ccenter'den (Solwind'in eski adı) kopyalandı: $cfg/ccenter -> $cfg/solwind"
    else
        rm -f "$cfg/solwind/settings.json.part"
        err "solwind: could not copy the settings from $cfg/ccenter; starting with default settings" \
            "solwind: ayarlar $cfg/ccenter klasöründen kopyalanamadı; varsayılan ayarlarla başlıyor"
    fi
}
# Wait (at most ~10 s) until solwindd answers. 0 = it does
wait_up() {
    n=0
    while [ "$n" -lt 50 ]; do up && return 0; sleep 0.2; n=$((n + 1)); done
    return 1
}
# Why it didn't start: exit 3 = an old Solwind app drives the fans (solwindd checks at start), else its log.
# Sets start_failed to the exit code this command ends with (the window still opens: it says the service isn't running,
# which matters when Solwind was started from the menu, with no terminal to show this)
start_failed=""
not_started() {    # $1: the unit (or "" without systemd), $2: its exit code if known
    if [ "${2:-}" = 3 ]; then
        err "solwind: not started: a Solwind app of 0.5.x or older (or Ccenter) is running and drives the fans; quit it first" \
            "solwind: başlatılmadı: 0.5.x ya da daha eski bir Solwind uygulaması (ya da Ccenter) çalışıyor ve fanları sürüyor; önce onu kapat"
        start_failed=3
        return 1
    fi
    err "solwind: the background service didn't start" "solwind: arka plan servisi başlamadı"
    [ -z "$1" ] || journalctl --user -u "$1" -n 8 --no-pager -o cat 2>/dev/null | sed 's/^/  /' >&2
    start_failed=1
    return 1
}
# Starts solwindd if it isn't running: as the installed service (systemd restarts it after a crash and hands the
# fans back in any case); not installed (a source checkout), as a transient service with the same hand-back
# (systemd-run); SOLWIND_NO_SYSTEMD=1 (tests) in the background with this environment
start_daemon() {
    up && return 0
    copy_old_settings
    if unit_ours; then
        systemctl --user start solwind.service 2>/dev/null \
            || { not_started solwind.service "$(systemctl --user show -p ExecMainStatus --value solwind.service 2>/dev/null)"; return 1; }
        wait_up || not_started solwind.service
    elif [ -z "${SOLWIND_NO_SYSTEMD:-}" ] && command -v systemd-run >/dev/null 2>&1; then
        # (a failed run of an earlier start is cleared first; the fans' hand-back after it has gone as the installed
        # service's: solwindd --hand-back. The paths go in as environment variables, whole: --setenv isn't split on
        # spaces; $$ is a literal $ for the shell systemd starts)
        systemctl --user reset-failed solwind-dev.service >/dev/null 2>&1
        systemd-run --user --unit=solwind-dev --collect --quiet -p Type=dbus -p BusName=solwind.Daemon \
            --setenv="SOLWIND_APP_DIR=$dir" --setenv="SOLWIND_DAEMON=$daemon" -p TimeoutStopSec=30 \
            -p "Description=Solwind (solwindd of $dir)" \
            -p "ExecStopPost=-/bin/sh -c 'exec \"\$\$SOLWIND_DAEMON\" --hand-back'" \
            "$daemon" >/dev/null 2>&1 \
            || { not_started solwind-dev.service "$(systemctl --user show -p ExecMainStatus --value solwind-dev.service 2>/dev/null)"; return 1; }
        wait_up || not_started solwind-dev.service
    elif [ -n "${SOLWIND_NO_SYSTEMD:-}" ]; then
        # (a background job isn't a process group leader, so setsid runs solwindd itself: $! is its pid, and a start
        # it refused can be told by its exit code)
        SOLWIND_APP_DIR=$dir setsid "$daemon" </dev/null >>"${SOLWIND_DAEMON_LOG:-/dev/null}" 2>&1 &
        dpid=$!
        n=0
        while [ "$n" -lt 50 ]; do
            up && return 0
            kill -0 "$dpid" 2>/dev/null || { wait "$dpid"; not_started "" $?; return 1; }
            sleep 0.2; n=$((n + 1))
        done
        not_started ""
    else
        err "solwind: systemd (systemctl, systemd-run) is needed to run Solwind's background service" \
            "solwind: Solwind'in arka plan servisi için systemd (systemctl, systemd-run) gerekli"
        exit 1
    fi
}

# ---------- the window (Quickshell) ----------
command -v qs >/dev/null 2>&1 || qs_missing=1
# The window app's instance is found by its folder on any display, so this also works from a TTY or over SSH
ui_ipc() { qs ipc --any-display -p "$dir" "$@"; }
ui_running() { [ -z "${qs_missing:-}" ] && ui_ipc show >/dev/null 2>&1; }
# The window app: the QML module Solwind from $lib/qml; SOLWIND_LIB tells it which solwindd it belongs to (the
# autostart toggle)
ui_env() { env QML_IMPORT_PATH="$lib/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" SOLWIND_LIB="$lib" "$@"; }
need_qs() {
    [ -z "${qs_missing:-}" ] || { err "solwind: quickshell (qs) is not installed" "solwind: quickshell (qs) kurulu değil"; exit 1; }
}
# Opens the window (started in the background, away from this terminal, if it isn't running)
open_window() {
    need_qs
    # The service has just started the tray icon's instance (solwind-tray.service): that one gets the window
    if ! ui_running && unit_ours && [ "$(systemctl --user is-active solwind-tray.service 2>/dev/null)" != inactive ]; then
        n=0
        while [ "$n" -lt 25 ] && ! ui_running; do sleep 0.2; n=$((n + 1)); done
    fi
    command -v setsid >/dev/null 2>&1 || { err "solwind: setsid (util-linux) is needed" "solwind: setsid (util-linux) gerekli"; exit 1; }
    # An instance without a window ends by itself when the tray is off (shell.qml): one found just then can be gone
    # before it takes "open". So "open" counts once it was taken and the instance still answers a moment later.
    tries=0
    while [ "$tries" -lt 3 ]; do
        tries=$((tries + 1))
        if ! ui_running; then
            ui_env setsid -f qs -p "$dir" -n </dev/null >/dev/null 2>&1
            n=0
            while [ "$n" -lt 50 ] && ! ui_running; do sleep 0.2; n=$((n + 1)); done
        fi
        ui_running && ui_ipc call cc open >/dev/null 2>&1 && sleep 0.5 && ui_running && return 0
        sleep 0.5
    done
    err "solwind: the window didn't open. Its log: qs log -p $dir" "solwind: pencere açılmadı. Günlüğü: qs log -p $dir"
    exit 1
}

# quit [--pid PID]: the window (if it runs) and solwindd quit; waits (at most ~30 s) until solwindd is gone, so the
# fans have been handed back when it returns. (--pid: the service of 0.5.x and older stopped the window app this
# way; kept for an upgrade while such a unit is still loaded)
quit_all() {
    if [ "${1:-}" = --pid ]; then
        pid=${2:-}
        [ -n "$pid" ] || exit 0
        is_int "$pid" || usage_error "Usage: solwind quit [--pid <process id>]" "Kullanım: solwind quit [--pid <süreç no>]"
        qs ipc --pid "$pid" call cc quit >/dev/null 2>&1 || exit 0
        n=0
        while [ "$n" -lt 50 ] && [ -e "/proc/$pid" ]; do sleep 0.2; n=$((n + 1)); done
        exit 0
    fi
    ui=0; ui_running && ui=1
    if ! up && [ $ui = 0 ]; then
        err "solwind: Solwind isn't running" "solwind: Solwind çalışmıyor"
        exit 0
    fi
    # The window quits solwindd itself and goes once it has; without it, solwindd is asked directly
    if [ $ui = 1 ]; then ui_ipc call cc quit >/dev/null 2>&1; fi
    up && "$daemon" --call daemon Quit >/dev/null 2>&1
    n=0
    while [ "$n" -lt 150 ] && { up || ui_running; }; do sleep 0.2; n=$((n + 1)); done
    up && { err "solwind: the background service hasn't quit yet" "solwind: arka plan servisi henüz kapanmadı"; exit 1; }
    exit 0
}

# solwind <command> --help
case "${2:-}" in -h|--help) case "${1:-}" in ""|-*) ;; *) usage_for "$1"; exit 0 ;; esac ;; esac

case "${1:-}" in
    ""|open|-d|--detach)
        need_qs
        start_daemon
        open_window
        exit ${start_failed:-0} ;;
    --background)
        # The tray icon (solwind-tray.service): the window app without a window; it ends by itself when the tray is
        # off. Already running (a window opened before): nothing to do.
        need_qs
        if ui_running; then
            err "solwind: the window app is already running" "solwind: pencere uygulaması zaten çalışıyor"
            exit 3
        fi
        exec env SOLWIND_BACKGROUND=1 QML_IMPORT_PATH="$lib/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" SOLWIND_LIB="$lib" \
            qs -p "$dir" -n ;;
    --migrate)
        # (the service, before solwindd starts: the Ccenter settings copy above)
        copy_old_settings; exit 0 ;;
    hide|toggle)
        need_qs
        if ui_running; then ui_ipc call cc "$1" >/dev/null; exit 0; fi
        if [ "$1" = hide ]; then
            err "solwind: the window app isn't running" "solwind: pencere uygulaması çalışmıyor"
            exit 4
        fi
        start_daemon
        open_window
        exit ${start_failed:-0} ;;
    log)
        # solwindd's log (the service's journal; a source checkout's transient service too). Ctrl+C only stops it.
        shift
        command -v journalctl >/dev/null 2>&1 || { err "solwind: journalctl (systemd) is needed" "solwind: journalctl (systemd) gerekli"; exit 1; }
        case "${1:-}" in
            "") exec journalctl --user -u solwind.service -u solwind-dev.service -u solwind-tray.service -n 100 --no-pager ;;
            *) exec journalctl --user -u solwind.service -u solwind-dev.service -u solwind-tray.service -n 100 "$@" ;;
        esac ;;
    status)
        need_up; dcall fans StatusText ;;
    profiles)
        need_up; dcall fans ProfileList ;;
    quit)
        shift; quit_all "$@" ;;
    profile)
        need_up
        if [ $# -lt 2 ]; then dcall fans CurrentProfile; else shift; dcall fans ApplyProfile sb "$*" true; fi ;;
    boost)
        case "${2:-}" in
            ""|on|off) ;;
            *) is_int "$2" || usage_error "Usage: solwind boost [minutes | on | off]" "Kullanım: solwind boost [dakika | on | off]" ;;
        esac
        need_up
        case "${2:-}" in
            "") dcall fans BoostStatus ;;
            on) dcall fans SetBoost x -1 && dcall fans BoostStatus ;;
            off) dcall fans SetBoost x 0 && dcall fans BoostStatus ;;
            *) dcall fans SetBoost x "$2" && dcall fans BoostStatus ;;
        esac ;;
    kbd)
        # wrong usage is reported before "not running"
        case "${2:-}" in
            ""|info) ;;
            color) [ $# -ge 3 ] || usage_error "Usage: solwind kbd color <#rrggbb>" "Kullanım: solwind kbd color <#rrggbb>" ;;
            effect) [ $# -ge 3 ] || usage_error "Usage: solwind kbd effect <static|breathing|cycle>" "Kullanım: solwind kbd effect <static|breathing|cycle>" ;;
            source) [ $# -ge 3 ] || usage_error "Usage: solwind kbd source <single|multi|theme>" "Kullanım: solwind kbd source <single|multi|theme>" ;;
            brightness|speed|themecount)
                [ $# -ge 3 ] && is_int "$3" || usage_error "Usage: solwind kbd $2 <number>" "Kullanım: solwind kbd $2 <sayı>" ;;
            range)
                [ $# -ge 4 ] && is_int "$3" && is_int "$4" || usage_error "Usage: solwind kbd range <lowest %> <highest %>" "Kullanım: solwind kbd range <en düşük %> <en yüksek %>" ;;
            *) err "solwind: unknown kbd command: $2" "solwind: bilinmeyen kbd komutu: $2"; usage_for kbd >&2; exit 2 ;;
        esac
        need_up
        case "${2:-}" in
            "") dcall keyboard StatusText ;;
            info) dcall keyboard InfoText ;;
            color) dcall keyboard SetColor s "$3" ;;
            brightness) dcall keyboard SetBrightness i "$3" ;;
            effect) dcall keyboard SetEffect s "$3" ;;
            themecount) dcall keyboard SetThemeCount i "$3" ;;
            source) dcall keyboard SetSource s "$3" ;;
            range) dcall keyboard SetRange ii "$3" "$4" ;;
            speed) dcall keyboard SetSpeed i "$3" ;;
        esac ;;
    report)
        # Diagnostic report (works without Solwind running): one text file in your home folder
        exec sh "$dir/scripts/report.sh" "$dir" ;;
    lang)
        case "${2:-}" in ""|tr|en) ;; *) usage_error "tr | en" "tr | en" ;; esac
        need_up
        if [ $# -ge 2 ]; then dcall daemon SetLanguage s "$2" || exit $?; l=$2; else l=$("$daemon" --get daemon Language) || exit 1; fi
        # (in that language, as the window answered)
        if [ "$l" = tr ]; then echo "Dil: Türkçe"; else echo "Language: English"; fi ;;
    -h|--help)
        usage ;;
    help)
        if [ -n "${2:-}" ]; then usage_for "$2"; else usage; fi ;;
    -V|--version)
        v=$(cat "$dir/VERSION" 2>/dev/null || echo "?"); echo "solwind $v ($dir)" ;;
    *)
        err "solwind: unknown command: $1" "solwind: bilinmeyen komut: $1"; usage >&2; exit 2 ;;
esac
