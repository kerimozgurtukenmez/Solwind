[Desktop Entry]
Version=1.5
Type=Application
Name=Solwind
GenericName=Fan Control
Comment=Laptop fan and keyboard control center for Caelestia
Comment[tr]=Caelestia için dizüstü fan ve klavye kontrol merkezi
Exec=@BINDIR@/solwind
Icon=solwind
Terminal=false
Categories=Settings;HardwareSettings;
