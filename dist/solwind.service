# Solwind's background service (systemd user service): solwindd, which drives the fans and the keyboard light.
# make install puts it into <prefix>/lib/systemd/user (/usr/local/lib/systemd/user) and fills in the @...@ paths.
# Started by `solwind` when it isn't running; "Start in the background on login" in the app enables it.
# Manually: systemctl --user enable --now solwind.service   |   off: systemctl --user disable --now solwind.service
# It pulls in solwind-tray.service (the window app in the background, for the tray icon; it ends at once when the
# tray is turned off): make install links it into solwind.service.wants.
[Unit]
Description=Solwind - fan and keyboard light control (solwindd)
PartOf=graphical-session.target
After=graphical-session.target
# A failure that doesn't go away (e.g. no session bus) stops after 5 starts in a minute: with RestartSec=3 systemd's
# default limit (5 in 10 s) is never reached, and every round would run ExecStopPost (the fans' hand-back) again
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Ready once it holds its D-Bus name (clients can talk to it from then on)
Type=dbus
BusName=solwind.Daemon
# (coming from Ccenter, Solwind's name before 0.4.0: its settings are copied over once, the old file stays)
ExecStartPre=-@BINDIR@/solwind --migrate
ExecStart=@LIBDIR@/solwindd
# The keyboard permission's rule template and checker (the app's "Grant permission")
Environment=SOLWIND_APP_DIR=@APPDIR@
# A stop (systemctl stop, solwind quit, logging out) is a SIGTERM: it hands the fans back and leaves the keyboard
# light on its static colour itself, within 20 s. In any case (a crash, a timeout) the fans are handed back afterwards
# the way the fan plugin in use recorded at start (the NBFC plugin: nbfc set -a; no fan plugin: nothing, the firmware
# keeps them), unless it didn't start (exit 3) because something else drives them
ExecStopPost=-@LIBDIR@/solwindd --hand-back
TimeoutStopSec=30
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=3

[Install]
WantedBy=graphical-session.target
