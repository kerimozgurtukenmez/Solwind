# Solwind background service (systemd user service).
# make install puts it into <prefix>/lib/systemd/user (/usr/local/lib/systemd/user);
# @BINDIR@ is replaced at install time with the folder that contains solwind.
# The app's "start in background on login" toggle enables/disables it.
# Manually: systemctl --user enable --now solwind.service   |   off: systemctl --user disable --now solwind.service
[Unit]
Description=Solwind - fan and keyboard control center (background)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Starts without a window; to open it: solwind
ExecStart=@BINDIR@/solwind --background
# When stopping, ask it to quit cleanly first: keyboard effect to the static colour, fans to NBFC (same as Quit).
# Only this service's own process ($MAINPID; empty if it has already exited), never a copy started outside it.
ExecStop=-@BINDIR@/solwind quit --pid $MAINPID
# In any case (crash, timeout) the fans go back to NBFC's automatic control, unless the start was refused (exit 3)
# because another Solwind copy runs and drives them ($$ is a literal $ for the shell)
ExecStopPost=-/bin/sh -c '[ "$${EXIT_STATUS:-}" = 3 ] || exec /usr/bin/nbfc set -a'
Restart=on-failure
RestartSec=3
# If another Solwind copy is running, solwind exits with 3: don't keep restarting
RestartPreventExitStatus=3

[Install]
WantedBy=graphical-session.target
