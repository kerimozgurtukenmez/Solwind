# Solwind's plugin SDK, installed with Solwind: find_package(SolwindSdk) gives the target Solwind::sdk (the headers and
# libsolwind-sdk.so), SOLWIND_SDK_ID (what solwindd checks a plugin was built against) and solwind_plugin().
# @SOLWIND_SDK_PREFIX_NOTE@
include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.5 COMPONENTS Core Gui)

set(SOLWIND_SDK_ID "@SOLWIND_SDK_ID@")
@SOLWIND_SDK_ROOT@
if(NOT TARGET Solwind::sdk)
    add_library(Solwind::sdk SHARED IMPORTED)
    set_target_properties(Solwind::sdk PROPERTIES
        IMPORTED_LOCATION "${_solwind_lib}/libsolwind-sdk.so"
        IMPORTED_SONAME "libsolwind-sdk.so"
        INTERFACE_INCLUDE_DIRECTORIES "${_solwind_include}"
        INTERFACE_COMPILE_DEFINITIONS "QT_NO_CAST_FROM_ASCII;QT_NO_CAST_TO_ASCII"
        INTERFACE_LINK_LIBRARIES "Qt6::Core;Qt6::Gui")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/SolwindPlugin.cmake")
